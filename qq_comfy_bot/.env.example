DEEPSEEK_API_KEY=在这里填写你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=请替换为NapCat中设置的token
# 你的QQ号码，多个用英文逗号分隔；为空则拒绝所有人
ALLOWED_USERS=123456789
# 留空关闭群聊；启用后仅响应白名单用户的@或/bot 消息
ALLOWED_GROUPS=
COMFYUI_URL=http://127.0.0.1:8188
TIMEZONE=Asia/Shanghai
IMAGE_TIMEOUT=600
# off=仅明确要求时发图；auto=允许模型随聊天主动发图（每会话至少间隔120秒）
IMAGE_MODE=off
# Automatic picture cooldown is preferences.json drawing.cooldown_minutes (minutes).

# 默认一次主模型请求；可选口吻改写会额外消耗一次请求，默认关闭
SPEECH_REVIEW_ENABLED=0
# 仅在明确配置兼容的视觉服务后启用附件识别；留空时如实说明未识别
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=

# 官方deepseek-flash默认将QQ图片随主请求一起发送，无额外识图调用
NATIVE_VISION_ENABLED=1

# 结构错误默认不额外请求；设为1才允许一次结构重试
CHAT_SCHEMA_RETRY=0

# ComfyUI 空闲卸载：只用 /free，保留服务；默认连续空闲一小时
GPU_IDLE_UNLOAD_ENABLED=1
GPU_IDLE_TIMEOUT_SECONDS=3600
GPU_IDLE_CHECK_INTERVAL_SECONDS=60
